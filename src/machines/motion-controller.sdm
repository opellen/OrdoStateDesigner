  "transitions": [
    {
      "id": 9,
      "from": 1,
      "to": 2,
      "event": "START_CALIBRATION",
      "guard": "!isCalibrated",
      "action": "stepCount = 0",
      "delayMs": 0,
      "labelOffsetX": 0.0,
      "labelOffsetY": 0.0,
      "color": "Default",
      "machineSelf": false
    },
    {
      "id": 10,
      "from": 2,
      "to": 2,
      "event": "CALIBRATION_STEP",
      "guard": "stepCount < 3",
      "action": "stepCount = stepCount + 1",
      "delayMs": 0,
      "labelOffsetX": 0.0,
      "labelOffsetY": 0.0,
      "color": "Default",
      "machineSelf": false
    },
    {
      "id": 11,
      "from": 2,
      "to": 1,
      "event": "CALIBRATION_STEP",
      "guard": "stepCount >= 3 && !isCalibrated",
      "action": "isCalibrated = true",
      "delayMs": 0,
      "labelOffsetX": 0.0,
      "labelOffsetY": 0.0,
      "color": "Default",
      "machineSelf": false
    },
    {
      "id": 12,
      "from": 1,
      "to": 4,
      "event": "START_NAVIGATION",
      "guard": "isCalibrated && (abs(targetX - x) > tolerance || abs(targetY - y) > tolerance)",
      "action": "distance = sqrt(pow(targetX - x, 2.0) + pow(targetY - y, 2.0))",
      "delayMs": 0,
      "labelOffsetX": 0.0,
      "labelOffsetY": 35.0,
      "color": "Default",
      "machineSelf": false
    },
    {
      "id": 13,
      "from": 4,
      "to": 5,
      "event": "TICK",
      "guard": "velocity + acceleration >= maxVelocity",
      "action": "velocity = maxVelocity",
      "delayMs": 0,
      "labelOffsetX": 0.0,
      "labelOffsetY": 0.0,
      "color": "Default",
      "machineSelf": false
    },
    {
      "id": 14,
      "from": 4,
      "to": 4,
      "event": "TICK",
      "guard": "velocity + acceleration < maxVelocity && distance > 20.0",
      "action": "velocity = min(velocity + acceleration * 0.8, maxVelocity)",
      "delayMs": 0,
      "labelOffsetX": 0.0,
      "labelOffsetY": 0.0,
      "color": "Default",
      "machineSelf": false
    },
    {
      "id": 15,
      "from": 5,
      "to": 6,
      "event": "TICK",
      "guard": "targetX - x <= pow(velocity, 2.0) / (2.0 * acceleration) + 5.0",
      "action": "velocity = max(velocity - 2.0, 5.0)",
      "delayMs": 0,
      "labelOffsetX": 0.0,
      "labelOffsetY": 0.0,
      "color": "Default",
      "machineSelf": false
    },
    {
      "id": 16,
      "from": 5,
      "to": 7,
      "event": "TICK",
      "guard": "distance > 15.0 && stepCount % heartbeatInterval == 0",
      "action": "distance = Math.sqrt(Math.pow(targetX - x, 2.0) + Math.pow(targetY - y, 2.0))",
      "delayMs": 0,
      "labelOffsetX": 0.0,
      "labelOffsetY": -48.0,
      "color": "Default",
      "machineSelf": false
    },
    {
      "id": 17,
      "from": 5,
      "to": 5,
      "event": "TICK",
      "guard": "",
      "action": "x = round((x + velocity * 0.1) * 100.0) / 100.0",
      "delayMs": 0,
      "labelOffsetX": 0.0,
      "labelOffsetY": 0.0,
      "color": "Default",
      "machineSelf": false
    },
    {
      "id": 18,
      "from": 7,
      "to": 5,
      "event": "RESUME",
      "guard": "headingAngle < 2.0 * Math.PI",
      "action": "headingAngle = floor((headingAngle + 0.25) * 10.0) / 10.0",
      "delayMs": 0,
      "labelOffsetX": 0.0,
      "labelOffsetY": 0.0,
      "color": "Default",
      "machineSelf": false
    },
    {
      "id": 19,
      "from": 7,
      "to": 5,
      "event": "RESUME",
      "guard": "headingAngle >= 2.0 * Math.PI && tolerance > 0.0",
      "action": "headingAngle = ceil(headingAngle) - 6.0",
      "delayMs": 0,
      "labelOffsetX": 0.0,
      "labelOffsetY": 48.0,
      "color": "Default",
      "machineSelf": false
    },
    {
      "id": 20,
      "from": 6,
      "to": 8,
      "event": "TICK",
      "guard": "abs(targetX - x) <= tolerance && abs(targetY - y) <= tolerance",
      "action": "velocity = 0.0",
      "delayMs": 0,
      "labelOffsetX": 0.0,
      "labelOffsetY": 0.0,
      "color": "Default",
      "machineSelf": false
    },
    {
      "id": 21,
      "from": 6,
      "to": 6,
      "event": "TICK",
      "guard": "velocity > 1.0 && abs(targetX - x) > tolerance",
      "action": "velocity = max(velocity - acceleration * 0.5, 1.0)",
      "delayMs": 0,
      "labelOffsetX": 0.0,
      "labelOffsetY": 0.0,
      "color": "Default",
      "machineSelf": false
    },
    {
      "id": 22,
      "from": 3,
      "to": 1,
      "event": "ABORT",
      "guard": "",
      "action": "velocity = 0.0",
      "delayMs": 0,
      "labelOffsetX": 30.0,
      "labelOffsetY": -35.0,
      "color": "Default",
      "machineSelf": false
    },
    {
      "id": 23,
      "from": 8,
      "to": 1,
      "event": "RESET",
      "guard": "",
      "action": "isCalibrated = false",
      "delayMs": 0,
      "labelOffsetX": 0.0,
      "labelOffsetY": 0.0,
      "color": "Default",
      "machineSelf": false
    }
  ],
  "notes": [
    {
      "id": 24,
      "x": -380.0,
      "y": 140.0,
      "text": "Motion Controller Test Machine:\nExercises arithmetic (+ - * / %), math functions (sqrt, pow, abs, round, floor, ceil, min, max),\nMath namespace aliases (Math.sqrt, Math.pow), constants (Math.PI), and compound guards/assigns.",
      "color": "Blue"
    }
  ]
